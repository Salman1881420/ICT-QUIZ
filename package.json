{
  "name": "animestream",
  "version": "1.0.0",
  "description": "Modern anime streaming web application with advanced features - optimized for Vercel deployment",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
