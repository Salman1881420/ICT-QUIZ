# Site Configuration
NEXT_PUBLIC_SITE_URL=https://animestream.vercel.app
NEXT_PUBLIC_APP_NAME=AnimeStream

# Analytics & SEO
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
GOOGLE_VERIFICATION_ID=your_google_verification_id
BING_VERIFICATION_ID=your_bing_verification_id
YANDEX_VERIFICATION_ID=your_yandex_verification_id

# API Configuration
NEXT_PUBLIC_API_URL=https://api.consumet.org
API_TIMEOUT=30000

# Performance Monitoring
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your_vercel_analytics_id

# Security
NEXT_PUBLIC_CSP_NONCE=your_csp_nonce

# Feature Flags
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_SERVICE_WORKER=true

# Development
NODE_ENV=production